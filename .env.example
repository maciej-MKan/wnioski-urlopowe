# Szablon konfiguracji sekretów. Skopiuj do `.env` (gitignored) i uzupełnij,
# albo użyj `./setup.sh`, który zapyta/wygeneruje hasło i utworzy `.env`.

# Hasło bazy PostgreSQL (§23.1). Wymagane przy uruchomieniu (docker compose bez niego
# przerwie z komunikatem). Powinno być URL-safe (litery/cyfry) — trafia też do WNIOSKI_DB_URL.
POSTGRES_PASSWORD=
